# Copy this file to .env and fill in real values. Never commit .env.

# Token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Base URL of the FastAPI backend (uvicorn api:app)
API_URL=http://localhost:8000

# Comma-separated Telegram user IDs allowed to use the bot (e.g. 123456789,987654321).
# Get your own ID from @userinfobot on Telegram. Leave empty and the bot rejects everyone.
ALLOWED_USER_IDS=
